#!/bin/sh
# OpenDeck 测试门禁(git hook 主体,pre-push 与 pre-commit 共用)
#
# 目的:防止「测试与源码漂移数月、没人发现」的事故复发。
# 仓库没有远端时 pre-push 不会触发——本仓库即如此,已同时装成 pre-commit
# (门禁落在每次提交上,代价是每次提交多一次增量构建)。
#
# 用法:
#   Scripts/git-hooks/pre-push              # 手动跑一次
#   OPEN_DECK_TEST_CMD="swift build" ...    # 只验编译,跳过测试(应急)
#
# 注意:任何 hook 都可以 --no-verify 绕过(commit/push 各自支持)。绕过时请在提交信息里写明原因。

set -e

# 脚本所在的工程根(本脚本位于 <工程根>/Scripts/git-hooks/,上两级即工程根——
# 独立仓库时工程根=仓库根;拆分前的嵌套布局下同为 mirabox/,两层深度不变)
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
APP_DIR=$(CDPATH= cd -- "$HOOK_DIR/../.." && pwd)
# hook 名优先取转发器注入的环境变量:转发器 exec 后 $0 已变成本脚本自身路径,认不出源头
HOOK=${OPEN_DECK_HOOK:-$(basename "$0")}
TEST_CMD=${OPEN_DECK_TEST_CMD:-swift test}

cd "$APP_DIR"
echo "[$HOOK] OpenDeck 门禁: ${TEST_CMD}  (${APP_DIR})"

START=$(date +%s)
if $TEST_CMD; then
    echo "[$HOOK] 通过, 耗时 $(( $(date +%s) - START ))s"
    exit 0
fi

echo ""
echo "[$HOOK] ❌ 测试未通过，已阻止本次提交。"
echo "[$HOOK]    修复后重试；确认无害时可 --no-verify 绕过并在提交信息里说明。"
echo "[$HOOK]    只验编译：OPEN_DECK_TEST_CMD=\"swift build\" Scripts/git-hooks/pre-push"
exit 1
