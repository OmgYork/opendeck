#!/bin/sh
# OpenDeck 测试门禁(git pre-push hook 主体)
#
# 目的:防止「测试与源码漂移数月、没人发现」的事故复发。
# 仓库没有远端时 pre-push 不会触发——那种情况下请改用 pre-commit(见文末),或手动跑本脚本。
#
# 用法:
#   Scripts/git-hooks/pre-push              # 手动跑一次(等价于 push 前那道门)
#   OPEN_DECK_TEST_CMD="swift build" ...    # 只验编译,跳过测试(应急)
#
# 注意:任何 hook 都可以用 `git push --no-verify` 绕过。绕过时请在提交信息里写明原因。

set -e

# 脚本所在仓库的 mirabox 目录(本脚本位于 mirabox/Scripts/git-hooks/)
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
APP_DIR=$(CDPATH= cd -- "$HOOK_DIR/../.." && pwd)

TEST_CMD=${OPEN_DECK_TEST_CMD:-swift test}

cd "$APP_DIR"
echo "[pre-push] OpenDeck 门禁: ${TEST_CMD}  (${APP_DIR})"

START=$(date +%s)
if $TEST_CMD; then
    echo "[pre-push] 通过, 耗时 $(( $(date +%s) - START ))s"
    exit 0
fi

echo ""
echo "[pre-push] ❌ 测试未通过，已阻止 push。"
echo "[pre-push]    修复后重试；确认无害时可用 git push --no-verify 并在提交信息里说明。"
echo "[pre-push]    只验编译：OPEN_DECK_TEST_CMD=\"swift build\" Scripts/git-hooks/pre-push"
exit 1

# 没有远端仓库时（当前仓库即如此），pre-push 永远不会触发。把下面这行装成
# .git/hooks/pre-commit 即可让门禁落在每次提交上（代价是每次提交多花一次增量构建）：
#   ln -sf ../../mirabox/Scripts/git-hooks/pre-push .git/hooks/pre-commit
